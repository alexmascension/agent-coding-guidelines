# shellcheck shell=bash
# Role roots for DIPC Hyperion (HPC_GUIDELINES.md §1, storage roles; hpc_sites/DIPC_HYPERION.md).
# Copy to config/sites/hyperion.env. Sourced by scripts after PROJECT_ROOT is set; no secrets here.
: "${PROJECT_ROOT:?PROJECT_ROOT must be set}"
PROJECT_NAME="${PROJECT_NAME:-$(basename "${PROJECT_ROOT}")}"
PROJECT_WORK="/scratch/${USER}/${PROJECT_NAME}"
PROJECT_ARCHIVE="/data/${USER}/${PROJECT_NAME}"
PROJECT_NODE="/lscratch/${USER}/${SLURM_JOB_ID:-nojob}"
APPTAINER_CACHEDIR="${PROJECT_WORK}/cache/apptainer"
NXF_APPTAINER_CACHEDIR="${PROJECT_WORK}/cache/apptainer"
PIP_CACHE_DIR="${PROJECT_WORK}/cache/pip"
CONDA_PKGS_DIRS="${PROJECT_WORK}/cache/conda-pkgs"
export PROJECT_NAME PROJECT_WORK PROJECT_ARCHIVE PROJECT_NODE
export APPTAINER_CACHEDIR NXF_APPTAINER_CACHEDIR PIP_CACHE_DIR CONDA_PKGS_DIRS
