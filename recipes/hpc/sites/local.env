# shellcheck shell=bash
# Role roots for a single machine (HPC_GUIDELINES.md §1, storage roles): every role inside the clone.
# Copy to config/sites/local.env. Sourced by scripts after PROJECT_ROOT is set; no secrets here.
: "${PROJECT_ROOT:?PROJECT_ROOT must be set}"
PROJECT_NAME="${PROJECT_NAME:-$(basename "${PROJECT_ROOT}")}"
PROJECT_WORK="${PROJECT_ROOT}"
PROJECT_ARCHIVE="${PROJECT_ROOT}/archive"
PROJECT_NODE="${TMPDIR:-/tmp}/${USER}/${PROJECT_NAME}/${SLURM_JOB_ID:-$$}"
export PROJECT_NAME PROJECT_WORK PROJECT_ARCHIVE PROJECT_NODE
